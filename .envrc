# RL_duck 的环境声明。worker 上 DATASETS_ROOT / HF_HOME / HF_TOKEN / WANDB_API_KEY
# 由 /etc/environment 预置，这里只补这个仓自己要的东西。

export PROJECT_NAME="rl_duck"
export DATASETS_ROOT="${DATASETS_ROOT:-/mnt/nas_datasets}"
export NAS_ROOT="${NAS_ROOT:-${DATASETS_ROOT}}"

# 权重落 NAS，不进 git。
export RL_DUCK_CKPT_ROOT="${RL_DUCK_CKPT_ROOT:-${NAS_ROOT}/models/trained/rl_duck}"

# 训练一律离线记录，事后 wandb sync。
export WANDB_MODE=offline
export WANDB_PROJECT=rl_duck

# 无头机器上取画面必须走 EGL。少了它，MuJoCo 在建渲染器时直接抛
# 「an OpenGL platform library has not been loaded into this process」。
# 注意这条**只有渲染要**：训练时 render_mode=None，渲染器根本不初始化，
# 所以训练不设它也照样跑 —— 于是很容易在训完之后、要出图那一刻才撞上。
export MUJOCO_GL=egl

# 环境落本机磁盘：NAS 上跑 venv 启动很慢（实测顺序读 ~125MB/s），别放共享盘。
export UV_PROJECT_ENVIRONMENT="$HOME/.venv/rl_duck"

# 出图字体（西文 Times New Roman + 中文宋体的合并体）。它是专有字体，全仓唯一一份在
# 主仓里，不进这个仓。出图脚本从这个变量取；取不到就报错停下，不回落系统字体 ——
# 回落会让图看着"渲出来了"但字体不对，而且不报错。
export XBOTICS_FIG_FONT="${XBOTICS_FIG_FONT:-}"
